const stuPath = process.argv[3] || 'student.js';
let ok = 0, bad = 0;

function patch(file, steps) {
  let s = fs.readFileSync(file, 'utf8');
  const crlf = s.includes('\r\n');
  if (crlf) s = s.replace(/\r\n/g, '\n');
  if (s.includes('SAT-SPEAKING-PATCH')) {
    console.log(file + ': allaqachon qo\'llangan, o\'tkazib yuborildi');
    return;
  }
  fs.writeFileSync(file + '.bak', fs.readFileSync(file));
  for (const [name, from, to] of steps) {
    if (from instanceof RegExp) {
      if (!from.test(s)) { console.log('TOPILMADI:', name); bad++; continue; }
      s = s.replace(from, () => to);
    } else {
      const i = s.indexOf(from);
      if (i < 0) { console.log('TOPILMADI:', name); bad++; continue; }
      if (s.indexOf(from, i + 1) >= 0) { console.log('BIR NECHTA JOY:', name); bad++; continue; }
      s = s.slice(0, i) + to + s.slice(i + from.length);
    }
    ok++;
  }
  if (crlf) s = s.replace(/\n/g, '\r\n');
  fs.writeFileSync(file, s);
}

